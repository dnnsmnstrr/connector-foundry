{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/lib/**/*.js",
    "src/*.jsx",
    "src/components/**/*.jsx",
    "src/hooks/**/*.js",
    "src/site/**/*.js",
    "src/site/**/*.d.ts"
  ]
}
